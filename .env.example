# PostgreSQL connection used by Drizzle. Apply lib/db/schema.sql before first run.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/casemind

# CASEMIND investigator access (copy to ignored .env.local; never commit credentials)
CASEMIND_INVESTIGATOR_ID=investigator@casemind.local
CASEMIND_ACCESS_KEY=CHANGE_ME
CASEMIND_TOTP_SECRET=CHANGE_ME_TO_A_BASE32_SECRET
# At least 32 random characters. Required in production; local development uses a demo-only fallback.
CASEMIND_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional Vercel AI Gateway credentials. Without this, synthetic demo evidence
# uses the clearly labeled deterministic offline analyzer.
AI_GATEWAY_API_KEY=
CASEMIND_MODEL=openai/gpt-5-mini

# Optional official Hindsight TypeScript SDK connection.
# Cloud base URL (from the Hindsight Connect page): https://api.hindsight.vectorize.io
# For self-hosted deployments use the base URL provided by that deployment.
# Leave both values empty for local-only demo memory. A server request must
# succeed before CASEMIND labels Hindsight CONNECTED.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Legacy alias accepted if HINDSIGHT_BASE_URL is not set:
HINDSIGHT_API_URL=
# Optional prefix. Default produces isolated names: casemind-case-1, casemind-case-2.
HINDSIGHT_BANK_PREFIX=casemind
